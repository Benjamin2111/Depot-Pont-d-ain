# A copier dans les "Environment variables" de Netlify (et dans un fichier .env.local en local)

# Réglages > API dans votre projet Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=coller_ici_la_cle_anon_public

# ATTENTION : cette clé est secrète, ne jamais la mettre dans du code visible du navigateur.
# Réglages > API > service_role dans Supabase
SUPABASE_SERVICE_ROLE_KEY=coller_ici_la_cle_service_role
